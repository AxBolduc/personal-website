---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DATA } from '../data/resume';
---

<BaseLayout title="About">
  <main class="portfolio-stack">
    <section class="hero">
      <div>
        <p class="eyebrow">About</p>
        <h1>{DATA.name}</h1>
        <p class="lede">{DATA.summary}</p>
      </div>
      <picture class="avatar">
        <source srcset={DATA.avatar.srcset} sizes={DATA.avatar.sizes} type="image/webp" />
        <img src={DATA.avatar.src} alt={`Headshot of ${DATA.name}`} width="120" height="120" decoding="async" loading="lazy" />
      </picture>
    </section>
  </main>
</BaseLayout>
