---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DATA } from '../data/resume';
---

<BaseLayout title="Experience">
  <main class="portfolio-stack">
    <section class="section">
      <p class="section-label">Career</p>
      <h1>Experience</h1>
      <div class="timeline">
        {DATA.work.map((job) => (
          <article class="timeline-item">
            <div>
              <h3>{job.title}</h3>
              <p class="muted">{job.company}</p>
              <p>{job.description}</p>
            </div>
            <span class="dates">{job.start} — {job.end}</span>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
