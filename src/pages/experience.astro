---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Experience">
  <section class="section">
    <p class="eyebrow">Career</p>
    <h1>Experience</h1>
    <p class="lede">Use this page as a resume-style timeline of roles, impact, technologies, and achievements.</p>
  </section>
  <section class="grid">
    <article class="card">
      <h3>Role — Company</h3>
      <p>Dates · Location/Remote</p>
      <p>Summarize responsibilities, impact, and technologies used.</p>
    </article>
  </section>
</BaseLayout>
