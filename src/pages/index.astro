---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DATA } from '../data/resume';
---

<BaseLayout>
  <main class="portfolio-stack">
    <section class="hero" id="home">
      <div>
        <p class="eyebrow">{DATA.role} · {DATA.location}</p>
        <h1>Hi, I’m {DATA.name.split(' ')[0]}.</h1>
        <p class="lede">{DATA.description}</p>
      </div>
      <picture class="avatar">
        <source srcset={DATA.avatar.srcset} sizes={DATA.avatar.sizes} type="image/webp" />
        <img src={DATA.avatar.src} alt={`Headshot of ${DATA.name}`} width="120" height="120" decoding="async" fetchpriority="high" />
      </picture>
    </section>

    <section class="section" id="about">
      <h2>About</h2>
      <p>{DATA.summary}</p>
    </section>

    <section class="section" id="work">
      <h2>Work Experience</h2>
      <div class="timeline">
        {DATA.work.map((job) => (
          <article class="timeline-item detailed">
            <div>
              <h3>{job.title}</h3>
              <p class="muted">{job.company} · {job.location}</p>
              <p>{job.description}</p>
              <ul class="highlights">
                {job.highlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
              </ul>
              <div class="pills compact">
                {job.technologies.map((tech) => <span class="pill">{tech}</span>)}
              </div>
            </div>
            <span class="dates">{job.start} — {job.end}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="skills">
      <h2>Skills</h2>
      <div class="skill-groups">
        {DATA.skillGroups.map((group) => (
          <article class="skill-group">
            <h3>{group.label}</h3>
            <div class="pills compact">
              {group.items.map((skill) => <span class="pill">{skill}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="projects">
      <p class="section-label">Selected work</p>
      <h2>Check out my latest projects</h2>
      <p class="muted">A few examples of the products, tools, and systems I’ve worked on.</p>
      <div class="project-grid">
        {DATA.projects.map((project) => (
          <a class="project-card" href={project.href}>
            <div class="project-preview">
              {'image' in project ? (
                <img
                  src={project.image.src}
                  srcset={project.image.srcset}
                  sizes={project.image.sizes}
                  alt={project.image.alt}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span>{project.title}</span>
              )}
            </div>
            <div class="project-body">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <ul class="highlights compact-list">
                {project.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
              <div class="pills compact">
                {project.technologies.map((tech) => <span class="pill">{tech}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="education">
      <h2>Education</h2>
      <div class="timeline">
        {DATA.education.map((item) => (
          <article class="timeline-item">
            <div>
              <h3>{item.school}</h3>
              <p class="muted">{item.degree} · {item.detail}</p>
            </div>
            <span class="dates">{item.start} — {item.end}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section contact-card" id="contact">
      <p class="section-label">Contact</p>
      <h2>Let’s build something useful.</h2>
      <p class="muted">Have a role, project, or engineering problem worth discussing? I’d love to hear from you.</p>
      <div class="actions">
        <a class="button" href={`mailto:${DATA.contact.email}`}>Email me</a>
        <a class="button secondary" href={DATA.contact.github}>GitHub</a>
        <a class="button secondary" href={DATA.contact.linkedin}>LinkedIn</a>
      </div>
    </section>
  </main>
</BaseLayout>
