---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Software Engineer" description="Alex Bolduc's software engineering portfolio and career site.">
  <section class="hero">
    <p class="eyebrow">Software Engineer</p>
    <h1>Building thoughtful, reliable software systems.</h1>
    <p class="lede">
      I’m Alex Bolduc, a software engineer focused on creating maintainable applications,
      useful developer experiences, and dependable systems that solve real problems.
    </p>
    <div class="actions">
      <a class="button" href="/projects">View projects</a>
      <a class="button secondary" href="/contact">Get in touch</a>
    </div>
  </section>

  <section class="section">
    <h2>What I do</h2>
    <div class="grid">
      <article class="card">
        <h3>Product engineering</h3>
        <p>Turning ambiguous ideas into shipped, maintainable web applications.</p>
      </article>
      <article class="card">
        <h3>Systems thinking</h3>
        <p>Designing software with clear boundaries, practical tradeoffs, and room to evolve.</p>
      </article>
      <article class="card">
        <h3>Developer experience</h3>
        <p>Improving workflows, tooling, tests, and documentation so teams move with confidence.</p>
      </article>
    </div>
  </section>
</BaseLayout>
