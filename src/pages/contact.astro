---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DATA } from '../data/resume';
---

<BaseLayout title="Contact">
  <main class="portfolio-stack">
    <section class="section contact-card">
      <p class="section-label">Contact</p>
      <h1>Let’s connect.</h1>
      <p class="lede">Have a role, project, or engineering problem worth discussing? I’d love to hear from you.</p>
      <div class="actions">
        <a class="button" href={`mailto:${DATA.contact.email}`}>Email me</a>
        <a class="button secondary" href={DATA.contact.github}>GitHub</a>
        <a class="button secondary" href={DATA.contact.linkedin}>LinkedIn</a>
      </div>
    </section>
  </main>
</BaseLayout>
