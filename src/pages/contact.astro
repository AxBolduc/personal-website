---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <section class="section">
    <p class="eyebrow">Contact</p>
    <h1>Let’s connect.</h1>
    <p class="lede">Add your preferred contact links here: email, GitHub, LinkedIn, resume, or calendar.</p>
    <div class="actions">
      <a class="button" href="mailto:hello@example.com">Email me</a>
      <a class="button secondary" href="https://github.com/" rel="noreferrer">GitHub</a>
      <a class="button secondary" href="https://www.linkedin.com/" rel="noreferrer">LinkedIn</a>
    </div>
  </section>
</BaseLayout>
