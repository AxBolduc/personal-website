---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DATA } from '../data/resume';
---

<BaseLayout title="Projects">
  <main class="portfolio-stack">
    <section class="section">
      <p class="section-label">Selected work</p>
      <h1>Projects</h1>
      <p class="lede">A few examples of the products, tools, and systems I’ve worked on.</p>
      <div class="project-grid">
        {DATA.projects.map((project) => (
          <a class="project-card" href={project.href}>
            <div class="project-preview">
              {'image' in project ? (
                <img
                  src={project.image.src}
                  srcset={project.image.srcset}
                  sizes={project.image.sizes}
                  alt={project.image.alt}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span>{project.title}</span>
              )}
            </div>
            <div class="project-body">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <ul class="highlights compact-list">
                {project.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
              <div class="pills compact">
                {project.technologies.map((tech) => <span class="pill">{tech}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
