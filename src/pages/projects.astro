---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects">
  <section class="section">
    <p class="eyebrow">Selected work</p>
    <h1>Projects</h1>
    <p class="lede">Add a few standout projects with the problem, your role, the stack, and measurable outcomes.</p>
  </section>
  <section class="grid">
    <article class="card">
      <h3>Project name</h3>
      <p>Short description of what you built, why it mattered, and the engineering decisions behind it.</p>
    </article>
    <article class="card">
      <h3>Project name</h3>
      <p>Short description of another project, including links to code, demos, or case studies.</p>
    </article>
  </section>
</BaseLayout>
