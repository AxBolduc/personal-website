{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.3.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^13.5.1",
    "sharp": "^0.34.5",
    "wrangler": "^4.92.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
